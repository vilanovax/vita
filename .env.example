# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker

# Session signing key. REQUIRED — the app refuses to start without one that is
# at least 16 characters. Left blank on purpose so a fresh checkout fails fast
# instead of booting with a known/shared secret. Generate your own:
#   openssl rand -base64 48
AUTH_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── Seed (first run only) ───────────────────────────────────────────────────
# The seed script creates this admin account on an empty database. Choose a
# strong password before first run — do NOT ship the placeholder below.
#   openssl rand -base64 18
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<set-a-strong-password-before-first-run>

# ── Docker Compose (optional overrides) ───────────────────────────────────────
# APP_PORT=3001

# ── E2E tests (optional) ────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:3001
